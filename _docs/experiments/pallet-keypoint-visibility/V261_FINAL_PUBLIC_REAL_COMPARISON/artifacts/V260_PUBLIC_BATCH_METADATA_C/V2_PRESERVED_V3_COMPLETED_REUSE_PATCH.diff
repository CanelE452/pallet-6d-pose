+             'Reuse exact completed binding/metadata MD5/size/path')
+        need(not str(source['path']).casefold().endswith('.part'), 'Partial files never reused')
+        need(len(source['sha256']) == 64, 'Completed SHA256 required')
+        result[file_id] = r
