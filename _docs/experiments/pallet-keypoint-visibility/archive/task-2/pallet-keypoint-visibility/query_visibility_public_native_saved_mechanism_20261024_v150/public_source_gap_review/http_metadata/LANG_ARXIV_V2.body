                                <XMTok font="caligraphic" fontsize="70%" role="UNKNOWN">O</XMTok>
                              </XMApp>
                            </XMath>
                          </Math></foreignObject></g></g><g transform="translate(0.15,0.26)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="37.46" height="11.16" overflow="visible"><Math mode="inline" tex="\mathit{y}_{\mathcal{O}}" text="y _ O" xml:id="S3.F3.pic1.m12">
                            <XMath xml:id="S3.F3.pic1.m12.1">
