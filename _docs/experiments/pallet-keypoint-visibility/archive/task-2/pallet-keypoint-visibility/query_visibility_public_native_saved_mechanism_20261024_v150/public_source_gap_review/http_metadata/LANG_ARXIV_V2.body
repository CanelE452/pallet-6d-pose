                          </Math></foreignObject></g></g><g transform="translate(0.89,0.44)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="32.41" height="11.16" overflow="visible"><Math mode="inline" tex="\mathcal{O}" text="O" xml:id="S3.F3.pic1.m14">
                            <XMath xml:id="S3.F3.pic1.m14.1">
                              <XMTok font="caligraphic" role="UNKNOWN">O</XMTok>
                            </XMath>
                          </Math></foreignObject></g></g><g transform="translate(0.73,0.42)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="37.46" height="11.16" overflow="visible"><Math mode="inline" tex="\mathit{y}_{\mathcal{O}}" text="y _ O" xml:id="S3.F3.pic1.m15">
                            <XMath xml:id="S3.F3.pic1.m15.1">
                              <XMApp color="#00CA00" xml:id="S3.F3.pic1.m15.1.1">
