<td id="S4.T2.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.2.1.2.1" class="ltx_text ltx_font_bold">Avg. Time (s)</span></td>
<td id="S4.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.2.1.3.1" class="ltx_text ltx_font_bold">Freq. (Hz)</span></td></tr>
<tr id="S4.T2.2.2" class="ltx_tr">
