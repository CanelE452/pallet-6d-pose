<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.14</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">7.1</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<td id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t">Grounded Segmentation (SAM-2)</td>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.04</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">25.0</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<td id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t">Pose Estimation &amp; Adjustment</td>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.83</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.2</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
