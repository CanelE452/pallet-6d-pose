  </body>
  <script>
// Prompt logic v5 - Show all prompts by default
(function() {
  const categories = ['sunny','snowy','dark','occlusion'];
  const promptCache = {};

  function parsePrompts(text){
    const map = {};
    let current = null;
    // Include many dash variants: -, ‐(2010), ‑(2011), ‒(2012), –(2013), —(2014), •(2022), *
    const bulletRe = /^[\-\u2010\u2011\u2012\u2013\u2014\u2022*]\s*(.+)$/;
    text.replace(/^\uFEFF/, '');
    const lines = text.split(/\r?\n/);
    lines.forEach((raw)=>{
      const line = raw.trim();
      if(!line) return;
      if(/^[a-z]+[0-9]+:$/i.test(line)){
        current = line.slice(0,-1);
        map[current] = [];
        return;
      }
      const m = bulletRe.exec(line);
      if(m && current){
        const val = m[1].trim();
        if(val) map[current].push(val);
      }
    });
    return map;
  }

  async function loadCategoryPrompts(cat){
    if (promptCache[cat]) return promptCache[cat];
    try {
      const res = await fetch(`./static/datasets/${cat}/prompt.txt`, {cache:'no-cache'});
      if(!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      const map = parsePrompts(text);
      promptCache[cat]=map;
      return map;
    } catch(e){
      console.warn('Prompt load failed for',cat,e);
      promptCache[cat]={_error:e.message||'fetch-failed'};
      return promptCache[cat];
    }
  }

  function createPromptUI(prompts){
    const wrapper = document.createElement('div');
    wrapper.className='prompt-wrapper';

    // Show all prompts directly as a list
    const list = document.createElement('ul');
    list.className='prompt-list-all';
    
    prompts.forEach(p=>{
      const li=document.createElement('li');
      li.textContent=p;
      list.appendChild(li);
    });
    
    wrapper.appendChild(list);
    return wrapper;
  }

  function attachFailureMessage(itemEl, reason){
    if(itemEl.querySelector('.prompt-wrapper')) return;
    const fail=document.createElement('div');
    fail.className='prompt-wrapper prompt-error';
    fail.textContent=`Prompts unavailable (${reason||'no prompt.txt'}).`;
    itemEl.appendChild(fail);
  }

  async function processCategory(cat){
    const carousel = document.querySelector(`.dataset-carousel[data-category='${cat}']`);
    if(!carousel) return;
    const map = await loadCategoryPrompts(cat);
    const hadError = !!map._error;
    carousel.querySelectorAll('.item').forEach(item=>{
      const img = item.querySelector('img');
      if(!img) return;
      const base = (img.getAttribute('src')||'').split('/').pop().split('.')[0]; // basename
      const prompts = map[base];
      if(prompts && prompts.length){
        const existing = item.querySelector('.prompt-wrapper');
        if(existing) existing.remove(); // re-render (in case of old versions)
        item.appendChild(createPromptUI(prompts));
      } else if(hadError){
        attachFailureMessage(item, map._error);
      } else {
        attachFailureMessage(item, 'no matching key ('+base+')');
      }
    });
  }

  function init(){
    document.querySelectorAll('.dataset-carousel').forEach(c=>c.classList.add('with-prompts'));
    categories.forEach(processCategory);
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
  </script>
</html>
