.git.bak/
**/.git.bak/

# Claude Code local state
.claude/scheduled_tasks.lock
.claude/cache/
.claude/tasks/

# Project-local MCP server config (machine-specific paths)
.mcp.json

# Build artifacts
build/
BundleTrack/build
*.so

